# Get this from Neon (neon.tech) or Supabase (supabase.com) — both have a
# free tier sufficient for this stage. Create a project, copy the
# "connection string" / "pooled connection" URL, paste below.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Phase 2: for LLM-assisted bank transaction categorization
# ANTHROPIC_API_KEY="sk-ant-..."

# ── Вход и администрирование ──────────────────────────────────────────────
# E-mail администратора (через запятую, если несколько). Эти аккаунты получают
# роль администратора при регистрации или входе. В продакшене обязательно:
# без этой переменной администратора не будет.
FL_ADMIN_EMAILS="you@example.com"

# Кто оператор сервиса — показывается в политике и соглашении.
# Заполните после регистрации ОсОО.
# FL_OPERATOR_NAME="ОсОО «FinLite»"
# FL_OPERATOR_DETAILS="ИНН …, г. Бишкек, …"
# FL_CONTACT_EMAIL="support@example.kg"
# FL_CONTACT_TELEGRAM="@finlite_kg"

# Вход и тарифы. Пока не задано (или не "on") — открытый режим: вход не нужен,
# все видят все компании и пользуются всеми возможностями. Чтобы включить
# вход, роли и тарифы: NEXT_PUBLIC_FL_AUTH=on, затем redeploy.
NEXT_PUBLIC_FL_AUTH=

# Ежедневная задача (vercel.json → /api/cron/daily): загрузка курсов НБКР.
# Любая длинная случайная строка; Vercel сам передаёт её в заголовке.
CRON_SECRET=
