# Get this from Neon (neon.tech) or Supabase (supabase.com) — both have a
# free tier sufficient for this stage. Create a project, copy the
# "connection string" / "pooled connection" URL, paste below.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Phase 2: for LLM-assisted bank transaction categorization
# ANTHROPIC_API_KEY="sk-ant-..."

# Sign-in is OFF unless AUTH_ENABLED=1: the app is open, one shared workspace.
# Turn it on to get users, roles, the admin panel and per-company access.
# AUTH_ENABLED="1"

# Sign-in sessions: random string of 32+ characters (keep it secret).
# PowerShell: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }) -as [byte[]])
AUTH_SECRET="replace-with-a-long-random-string-at-least-32-chars"

# Who becomes administrator on sign-up / sign-in (comma-separated list).
ADMIN_EMAIL="you@example.com"
