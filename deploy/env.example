# FinLite KG — настройки собственного сервера. Скопируйте в deploy/.env и заполните.
# Файл .env содержит пароли: не отправляйте его по почте и не кладите в git.

# Адрес сайта: доменное имя (finlite.example.kg), IP во внутренней сети (10.0.5.20) или localhost
FL_SITE_ADDRESS=localhost
# Полный адрес для ссылок в письмах (сброс пароля), например https://finlite.example.kg
FL_SITE_URL=

# Пароль базы данных: длинная случайная строка (например: openssl rand -base64 32)
POSTGRES_PASSWORD=
# Секрет плановых задач: длинная случайная строка (openssl rand -hex 32)
CRON_SECRET=
# E-mail администраторов через запятую: эти учётные записи получают роль администратора
FL_ADMIN_EMAILS=

# Хранение журнала действий пользователей, дней (по умолчанию 5 лет)
FL_AUDIT_DAYS=1825
# Раздел администратора — только с двухфакторным входом (on/off)
FL_REQUIRE_ADMIN_2FA=on
# Выход после N минут бездействия: 0 — выключено (по умолчанию), включайте, только если этого требует регламент
FL_IDLE_MINUTES=0
# Порог предупреждения о заполнении базы, МБ (по умолчанию 50 ГБ)
FL_DB_LIMIT_MB=51200

# Резервные копии базы: время (по Бишкеку) и сколько дней хранить
BACKUP_AT=02:30
BACKUP_KEEP_DAYS=30

# Порты на сервере (если 80/443 заняты)
FL_HTTP_PORT=80
FL_HTTPS_PORT=443

# Оператор — для страниц «Политика» и «Соглашение»
FL_OPERATOR_NAME=
FL_OPERATOR_DETAILS=
FL_CONTACT_EMAIL=

# Необязательно: почта (Resend) и Telegram-бот для напоминаний
RESEND_API_KEY=
FL_MAIL_FROM=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Необязательно и по умолчанию выключено: ИИ-категоризация выписки (данные уходят во внешний сервис)
ANTHROPIC_API_KEY=
