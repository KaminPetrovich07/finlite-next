// ════════════════════════════════════════════════════════════════════════
// FinLite KG — Prisma schema (PostgreSQL)
//
// Phase 1 scope: replaces the single SQLite `reports` table from app.py
// (see _init_db / save_to_history / load_history) AND, unlike the current
// app, actually persists the data that today only lives in st.session_state
// and is lost on refresh: balance sheet (bsv), cash flow (cfv), ФОСАМК
// form data, and LeanOps module results.
//
// Design choice: balanceSheet / cashFlow / fosamk / leanResults are stored
// as Postgres JSONB rather than fully normalized tables. The line-item
// structures (BALANCE_ROWS, OPU_ROWS in app.py) are large, change rarely,
// and are always read/written as a whole document per report — JSONB is
// the pragmatic fit here and is still fully queryable in Postgres if
// needed later (e.g. `balanceSheet -> '299'`). If per-line-item reporting
// across companies becomes a real need, this is the first thing to
// normalize into proper child tables.
// ════════════════════════════════════════════════════════════════════════

generator client {
  provider        = "prisma-client-js"
  // driverAdapters: lets tests run the bundled WASM engine against a local
  // Postgres; production keeps the native engine (no adapter is passed).
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Users, roles and access ───────────────────────────────────────────────
// Reserved for sign-in, which is switched off for now (the app is one open
// workspace). Tables stay so that turning it back on needs no data migration.
// role: "admin" | "full" | "limited"
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String?
  role         String    @default("full")
  blocked      Boolean   @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  ownedCompanies Company[]     @relation("CompanyOwner")
  access         CompanyAccess[]
  feedback       Feedback[]
  activities     ActivityLog[]
}

model Company {
  id          String   @id @default(cuid())
  name        String
  inn         String?
  activity    String?
  defaultRegime String? // last-used regime_key, convenience default
  patentAmount  Float    @default(0) // monthly patent fee, used when regime = "patent"
  owner       User?    @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  ownerId     String?
  access      CompanyAccess[]
  reports     Report[]
  bankTransactions BankTransaction[]
  journalEntries   JournalEntry[]
  esgReports       EsgReport[]
  records          CompanyRecord[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
  @@index([ownerId])
}

/// A company shared with another user: level "view" or "edit".
model CompanyAccess {
  id        String   @id @default(cuid())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  level     String   @default("view")
  createdAt DateTime @default(now())

  @@unique([companyId, userId])
  @@index([userId])
}

/// Messages from users to the system's creator (admin inbox).
model Feedback {
  id        String    @id @default(cuid())
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?
  kind      String    @default("idea") // idea | bug | question | other
  page      String?
  message   String
  status    String    @default("new")  // new | in_progress | done
  reply     String?
  repliedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([status, createdAt])
}

/// Who did what — shown to the admin.
model ActivityLog {
  id        String   @id @default(cuid())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?
  action    String
  companyId String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}

// ── Core report: one calculation period for one company ───────────────────
// Field names intentionally mirror the `fr` dict returned by calculate()
// in app.py so porting/validation against the Python output is mechanical.
model Report {
  id          String   @id @default(cuid())
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId   String

  periodLabel String   // calc_period_label()
  periodFrom  DateTime
  periodTo    DateTime
  regimeKey   String   // e.g. "general", "unified_trade_l"
  regimeName  String

  // raw inputs (so a saved report can be re-opened and edited, unlike today)
  revenue       Float
  otherIncome   Float
  cogs          Float
  salaries      Float
  rent          Float
  sellingExp    Float
  adminExp      Float
  otherOpExp    Float
  interestExp   Float
  otherNonOp    Float
  investInc     Float
  cashPct       Float    @default(70)
  patentAmount  Float    @default(0)

  // computed outputs (from calculate())
  totalRevenue  Float
  grossProfit   Float
  ebit          Float
  ebt           Float
  netProfit     Float
  profitability Float
  social        Float
  vat           Float
  salesTax      Float
  incomeTax     Float
  totalDirect   Float
  totalIndirect Float

  // structured / nested data — see header comment
  balanceSheet  Json?    // BALANCE_ROWS values keyed by code, e.g. {"110": 12000, ...}
  cashFlow      Json?    // CF rows, same pattern
  equityStatement Json?  // EQUITY_ROWS x EQUITY_COLUMNS, keyed "code:colIndex" (Ф.№4)
  fosamkForms   Json?    // Ф.№1–4 raw form payloads
  leanResults   Json?    // {raw, muda, unitEconomics, swot, transport, medOrCon, ...}
  details       Json?    // tax breakdown dict from calculate()["details"]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([companyId, periodFrom])
}

// ── Bank statement import (new feature, see roadmap) ──────────────────────
model BankTransaction {
  id          String   @id @default(cuid())
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId   String

  bank        String   // "mbank" | "bakai" | "eldik"
  txDate      DateTime
  amount      Float    // positive = income, negative = expense
  description String
  category    String?  // assigned by rules or LLM
  categorySource String? // "rule" | "llm" | "manual"
  rawRow      Json?    // original parsed row, for audit/debugging

  importBatch String   // groups transactions from one uploaded file
  journalEntry JournalEntry? // the posting generated from this transaction
  createdAt   DateTime @default(now())

  @@index([companyId, txDate])
  @@index([importBatch])
}

// ── General ledger: single source of truth for every statement ────────────
// Every report (ОСВ, баланс, ОПиУ, ОДДС, отчёт о капитале, налоги) is DERIVED
// from these rows by lib/ledger/engine.ts — nothing is typed into a report
// directly, so the statements cannot disagree with each other.
//
// source:
//   "opening" — начальные остатки; counted only as balances, never as turnover
//   "manual"  — ручная проводка
//   "bank"    — сгенерирована из BankTransaction (bankTransactionId set)
//   "tax"     — начисление налогов за период (sourceRef = "YYYY-MM-DD..YYYY-MM-DD")
model JournalEntry {
  id          String   @id @default(cuid())
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId   String
  date        DateTime
  description String
  source      String   @default("manual")
  sourceRef   String?
  bankTransaction   BankTransaction? @relation(fields: [bankTransactionId], references: [id], onDelete: Cascade)
  bankTransactionId String?          @unique
  lines       JournalLine[]
  createdAt   DateTime @default(now())

  @@index([companyId, date])
  @@index([companyId, source, sourceRef])
}

model JournalLine {
  id          String       @id @default(cuid())
  entry       JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  entryId     String
  accountCode String       // see lib/ledger/accounts.ts
  debit       Decimal      @default(0) @db.Decimal(18, 2)
  credit      Decimal      @default(0) @db.Decimal(18, 2)
  memo        String?

  @@index([entryId])
  @@index([accountCode])
}

// ── ESG: non-financial inputs per company and period ──────────────────────
// Financial ESG metrics (energy cost, payroll, taxes, fines …) are computed
// from the journal by lib/esg.ts; only what money can't tell is stored here.
model EsgReport {
  id         String   @id @default(cuid())
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId  String
  periodFrom DateTime
  periodTo   DateTime
  data       Json     // EsgInput
  updatedAt  DateTime @updatedAt

  @@unique([companyId, periodFrom, periodTo])
}

// ── Company records: settings and reference data of one company ───────────
// One flexible table for everything that is a document rather than a
// posting: accounting policy, counterparties, costing cards, products…
// kind = "policy" | "counterparty" | "costing" | "product" | …;
// key  = "main" for singletons, otherwise the record's own id.
model CompanyRecord {
  id        String   @id @default(cuid())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String
  kind      String
  key       String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, kind, key])
  @@index([companyId, kind])
}
