// ════════════════════════════════════════════════════════════════════════
// FinLite KG — Prisma schema (PostgreSQL)
//
// Phase 1 scope: replaces the single SQLite `reports` table from app.py
// (see _init_db / save_to_history / load_history) AND, unlike the current
// app, actually persists the data that today only lives in st.session_state
// and is lost on refresh: balance sheet (bsv), cash flow (cfv), ФОСАМК
// form data, and LeanOps module results.
//
// Design choice: balanceSheet / cashFlow / fosamk / leanResults are stored
// as Postgres JSONB rather than fully normalized tables. The line-item
// structures (BALANCE_ROWS, OPU_ROWS in app.py) are large, change rarely,
// and are always read/written as a whole document per report — JSONB is
// the pragmatic fit here and is still fully queryable in Postgres if
// needed later (e.g. `balanceSheet -> '299'`). If per-line-item reporting
// across companies becomes a real need, this is the first thing to
// normalize into proper child tables.
// ════════════════════════════════════════════════════════════════════════

generator client {
  provider        = "prisma-client-js"
  // driverAdapters: lets tests run the bundled WASM engine against a local
  // Postgres; production keeps the native engine (no adapter is passed).
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Users, roles and access ───────────────────────────────────────────────
// role: "admin" — the system's administrator (sees every company, users,
// metrics, feedback); anything else is an ordinary user. Older rows may hold
// "full" or "limited" from the period without sign-in — they count as users.
model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  organization   String?   // where the user works — for the pilot
  phone          String?
  passwordHash   String?
  role           String    @default("user")
  blocked        Boolean   @default(false)
  failedLogins   Int       @default(0)
  lockedUntil    DateTime?
  consentAt      DateTime? // consent to personal data processing (Law of the KR No. 58)
  consentVersion String?
  plan           String    @default("free") // free | pro | max | premium | science | pilot (старые start/business = pro/max)
  paidUntil      DateTime?
  planNote       String?
  lastLoginAt    DateTime?
  totpSecret     String?
  totpEnabledAt  DateTime?
  totpLastStep   Int?
  totpBackup     String[]
  createdAt      DateTime  @default(now())
  ownedCompanies Company[]     @relation("CompanyOwner")
  access         CompanyAccess[]
  feedback       Feedback[]
  activities     ActivityLog[]
  sessions       Session[]
  resets         PasswordReset[]
  studyGroups    StudyGroup[]
  studyMembers   StudyMember[]
  submissions    Submission[]
}

/// A signed-in browser. id = SHA-256 of the cookie token (the token itself is never stored).
model Session {
  id         String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  ip         String?
  userAgent  String?

  @@index([userId])
  @@index([expiresAt])
}

/// One-time password reset link issued by the administrator. id = SHA-256 of the token.
model PasswordReset {
  id        String    @id
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Company {
  id          String   @id @default(cuid())
  name        String
  inn         String?
  activity    String?
  defaultRegime String? // last-used regime_key, convenience default
  patentAmount  Float    @default(0) // monthly patent fee, used when regime = "patent"
  owner       User?    @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  ownerId     String?
  access      CompanyAccess[]
  reports     Report[]
  bankTransactions BankTransaction[]
  journalEntries   JournalEntry[]
  esgReports       EsgReport[]
  records          CompanyRecord[]
  submissions      Submission[]
  entryEvents      EntryEvent[]
  attachments      Attachment[]
  /// запрет изменений: проводки с датой по этот день включительно нельзя добавить, изменить или удалить
  lockedThrough DateTime?
  lockedAt      DateTime?
  lockedByName  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([name])
  @@index([ownerId])
}

/// A company shared with another user: level "view" or "edit".
model CompanyAccess {
  id        String   @id @default(cuid())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  level     String   @default("view")
  createdAt DateTime @default(now())

  @@unique([companyId, userId])
  @@index([userId])
}

/// Messages from users to the system's creator (admin inbox).
model Feedback {
  id        String    @id @default(cuid())
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?
  kind      String    @default("idea") // idea | bug | question | other
  page      String?
  message   String
  status    String    @default("new")  // new | in_progress | done
  reply     String?
  repliedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([status, createdAt])
}

/// Who did what — shown to the admin.
model ActivityLog {
  id        String   @id @default(cuid())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?
  action    String
  companyId String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}

// ── Core report: one calculation period for one company ───────────────────
// Field names intentionally mirror the `fr` dict returned by calculate()
// in app.py so porting/validation against the Python output is mechanical.
model Report {
  id          String   @id @default(cuid())
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId   String

  periodLabel String   // calc_period_label()
  periodFrom  DateTime
  periodTo    DateTime
  regimeKey   String   // e.g. "general", "unified_trade_l"
  regimeName  String

  // raw inputs (so a saved report can be re-opened and edited, unlike today)
  revenue       Float
  otherIncome   Float
  cogs          Float
  salaries      Float
  rent          Float
  sellingExp    Float
  adminExp      Float
  otherOpExp    Float
  interestExp   Float
  otherNonOp    Float
  investInc     Float
  cashPct       Float    @default(70)
  patentAmount  Float    @default(0)

  // computed outputs (from calculate())
  totalRevenue  Float
  grossProfit   Float
  ebit          Float
  ebt           Float
  netProfit     Float
  profitability Float
  social        Float
  vat           Float
  salesTax      Float
  incomeTax     Float
  totalDirect   Float
  totalIndirect Float

  // structured / nested data — see header comment
  balanceSheet  Json?    // BALANCE_ROWS values keyed by code, e.g. {"110": 12000, ...}
  cashFlow      Json?    // CF rows, same pattern
  equityStatement Json?  // EQUITY_ROWS x EQUITY_COLUMNS, keyed "code:colIndex" (Ф.№4)
  fosamkForms   Json?    // Ф.№1–4 raw form payloads
  leanResults   Json?    // {raw, muda, unitEconomics, swot, transport, medOrCon, ...}
  details       Json?    // tax breakdown dict from calculate()["details"]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([companyId, periodFrom])
}

// ── Bank statement import (new feature, see roadmap) ──────────────────────
model BankTransaction {
  id          String   @id @default(cuid())
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId   String

  bank        String   // "mbank" | "bakai" | "eldik"
  txDate      DateTime
  amount      Float    // positive = income, negative = expense
  description String
  category    String?  // assigned by rules or LLM
  categorySource String? // "rule" | "llm" | "manual"
  rawRow      Json?    // original parsed row, for audit/debugging

  importBatch String   // groups transactions from one uploaded file
  journalEntry JournalEntry? // the posting generated from this transaction
  createdAt   DateTime @default(now())

  @@index([companyId, txDate])
  @@index([importBatch])
}

// ── General ledger: single source of truth for every statement ────────────
// Every report (ОСВ, баланс, ОПиУ, ОДДС, отчёт о капитале, налоги) is DERIVED
// from these rows by lib/ledger/engine.ts — nothing is typed into a report
// directly, so the statements cannot disagree with each other.
//
// source:
//   "opening" — начальные остатки; counted only as balances, never as turnover
//   "manual"  — ручная проводка
//   "bank"    — сгенерирована из BankTransaction (bankTransactionId set)
//   "tax"     — начисление налогов за период (sourceRef = "YYYY-MM-DD..YYYY-MM-DD")
model JournalEntry {
  id          String   @id @default(cuid())
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId   String
  date        DateTime
  description String
  source      String   @default("manual")
  sourceRef   String?
  bankTransaction   BankTransaction? @relation(fields: [bankTransactionId], references: [id], onDelete: Cascade)
  bankTransactionId String?          @unique
  lines       JournalLine[]
  /// кто ввёл и кто последним изменил проводку (имя хранится копией: запись переживёт удаление пользователя)
  createdById   String?
  createdByName String?
  updatedAt     DateTime?
  updatedByName String?
  createdAt   DateTime @default(now())

  @@index([companyId, date])
  @@index([companyId, source, sourceRef])
}

model JournalLine {
  id          String       @id @default(cuid())
  entry       JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  entryId     String
  accountCode String       // see lib/ledger/accounts.ts
  debit       Decimal      @default(0) @db.Decimal(18, 2)
  credit      Decimal      @default(0) @db.Decimal(18, 2)
  memo        String?
  /// контрагент (субконто): наименование и ИНН — для расчётов, актов сверки, первички
  party       String?
  partyInn    String?
  /// номенклатура: наименование ценностей, количество, единица измерения
  item        String?
  qty         Decimal?     @db.Decimal(18, 3)
  unit        String?
  /// валюта строки (USD, EUR, RUB, KZT, CNY …) и сумма в валюте; сумма в сомах — debit/credit
  currency    String?
  amountCur   Decimal?     @db.Decimal(18, 2)

  @@index([entryId])
  @@index([accountCode])
}

// ── ESG: non-financial inputs per company and period ──────────────────────
// Financial ESG metrics (energy cost, payroll, taxes, fines …) are computed
// from the journal by lib/esg.ts; only what money can't tell is stored here.
model EsgReport {
  id         String   @id @default(cuid())
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId  String
  periodFrom DateTime
  periodTo   DateTime
  data       Json     // EsgInput
  updatedAt  DateTime @updatedAt

  @@unique([companyId, periodFrom, periodTo])
}

// ── Company records: settings and reference data of one company ───────────
// One flexible table for everything that is a document rather than a
// posting: accounting policy, counterparties, costing cards, products…
// kind = "policy" | "counterparty" | "costing" | "product" | …;
// key  = "main" for singletons, otherwise the record's own id.
model CompanyRecord {
  id        String   @id @default(cuid())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String
  kind      String
  key       String
  data      Json
  /// вкладка браузера, сохранившая последней (X-FL-Client): её же повторные сохранения не считаются конфликтом
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, kind, key])
  @@index([companyId, kind])
}

// ── Официальные курсы валют НБКР ──────────────────────────────────────────
// Сом за 1 единицу валюты (rate / nominal уже пересчитан). Загружаются с
// nbkr.kg (daily.xml, weekly.xml) или вводятся вручную.
model FxRate {
  id        String   @id @default(cuid())
  date      DateTime
  code      String
  rate      Decimal  @db.Decimal(18, 6)
  source    String   @default("nbkr") // nbkr | manual
  createdAt DateTime @default(now())

  @@unique([date, code])
  @@index([code, date])
}

// ── Новости и наука ───────────────────────────────────────────────────────
// Публикации: новости, изменения законодательства, постановления, сборники,
// статьи, исследования, мнения. Автор правит и удаляет свою публикацию по
// секретному ключу, выданному при создании (в базе — только его SHA-256);
// администратор — всегда.
model Post {
  id         String    @id @default(cuid())
  kind       String    // news | law | regulation | collection | article | research | event | opinion
  title      String
  summary    String?
  body       String
  analysis   String?   // «Разбор FinLite»: свой текст редакции с графиками {{курсы …}}, {{график …}}
  sourceUrl  String?
  sourceName String?
  imageUrl   String?   // картинка-превью: из ленты источника или ссылка автора
  externalId String?   @unique // автосбор: источник + id записи, чтобы не задваивать
  auto       Boolean   @default(false) // собрано из ленты, а не опубликовано человеком
  docDate    DateTime? // дата документа или события
  tags       String[]
  authorName String
  authorOrg  String?
  userId     String?
  editHash   String?
  status     String    @default("published") // published | hidden
  pinned     Boolean   @default(false)
  views      Int       @default(0)
  useful     Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  comments   Comment[]

  @@index([status, createdAt])
  @@index([kind, createdAt])
}

/// Внешняя лента для раздела «Новости и наука»: RSS/Atom или публичный Telegram-канал.
model FeedSource {
  id        String    @id @default(cuid())
  name      String
  url       String    @unique // адрес ленты или https://t.me/s/<канал>
  type      String    // rss | telegram
  kind      String    @default("news") // вид публикаций по умолчанию
  filter    Boolean   @default(false) // брать только записи по темам раздела (для общих лент)
  tags      String[]
  enabled   Boolean   @default(true)
  lastRunAt DateTime?
  lastOk    Boolean?
  lastCount Int       @default(0) // записей в ленте при последней загрузке
  lastAdded Int       @default(0) // из них добавлено новых
  lastError String?
  createdAt DateTime  @default(now())
}

model Comment {
  id         String   @id @default(cuid())
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId     String
  parentId   String?
  authorName String
  authorOrg  String?
  body       String
  userId     String?
  editHash   String?
  status     String   @default("published")
  createdAt  DateTime @default(now())

  @@index([postId, createdAt])
}

/// «Полезно» — один голос с одного браузера (clientId из localStorage).
model PostVote {
  postId   String
  clientId String
  createdAt DateTime @default(now())

  @@id([postId, clientId])
}

// ── Реестр специалистов ───────────────────────────────────────────────────
// Только анкеты, которые человек заполнил и опубликовал сам, с согласием на
// обработку персональных данных. Рейтинг — открытая формула (lib/talent).
// Отзывы — только от работодателя с именем и организацией, без анонимных.
model Specialist {
  id              String    @id @default(cuid())
  fullName        String
  headline        String
  city            String?
  experienceYears Int       @default(0)
  specializations String[]
  skills          String[]
  workplaces      Json      // [{ org, position, from, to, current, duties }]
  education       Json      // [{ institution, degree, year }]
  certificates    Json      // [{ name, issuer, year, number, url }]
  about           String?
  availability    String    @default("open") // open | part | busy
  workFormat      String[]  // office | remote | outsource
  rateFrom        Int?      // желаемая оплата, сом в месяц
  phone           String?
  email           String?
  telegram        String?
  consentAt       DateTime
  consentText     String
  published       Boolean   @default(true)
  userId          String?
  editHash        String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  reviews         Review[]

  @@index([published, updatedAt])
}

model Review {
  id           String     @id @default(cuid())
  specialist   Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  specialistId String
  authorName   String
  authorOrg    String
  authorRole   String?
  relation     String     // employer | client | colleague
  rating       Int
  text         String
  reply        String?    // ответ специалиста
  userId       String?
  editHash     String?
  status       String     @default("published") // published | hidden
  createdAt    DateTime   @default(now())

  @@index([specialistId, createdAt])
}

/// Правовая база: полный текст закона, кодекса, постановления и его прежние редакции.
model LegalDoc {
  id         String         @id @default(cuid())
  slug       String         @unique
  title      String
  category   String
  kind       String         @default("law") // code | law | decree | nbkr | standard | other
  sourceUrl  String?        // официальная страница или файл — по нему проверяется новая редакция
  requisites String?        // «от 18 января 2022 № 3» — из шапки документа
  amendedAt  String?        // дата последних изменений из пометки «В редакции …»
  text       String?
  toc        Json?
  chars      Int            @default(0)
  hash       String?
  origin     String?        // url | file
  autoUpdate Boolean        @default(true)
  loadedAt   DateTime?
  checkedAt  DateTime?
  changedAt  DateTime?
  lastError  String?
  createdAt  DateTime       @default(now())
  editions   LegalEdition[]
}

model LegalEdition {
  id        String   @id @default(cuid())
  doc       LegalDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  docId     String
  hash      String
  text      String
  amendedAt String?
  changes   Json?    // какие статьи изменены по сравнению с этой редакцией
  createdAt DateTime @default(now())

  @@index([docId, createdAt])
}


/// Ошибки сайта: одинаковые сворачиваются в одну строку по отпечатку, count — сколько раз повторилась.
model ErrorEvent {
  id          String   @id @default(cuid())
  fingerprint String   @unique
  source      String   // client | server | api
  message     String
  stack       String?
  url         String?
  digest      String?
  userAgent   String?
  userId      String?
  count       Int      @default(1)
  firstAt     DateTime @default(now())
  lastAt      DateTime @default(now())
  resolved    Boolean  @default(false)

  @@index([lastAt])
}

/// Настройки сайта целиком (не компании): например, чаты Telegram для оповещений об ошибках.
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ── Учебный режим: группы, задания, работы студентов с автопроверкой ─────────
/// Учебная группа преподавателя; студенты вступают по коду.
model StudyGroup {
  id          String        @id @default(cuid())
  name        String
  code        String        @unique
  owner       User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId     String
  members     StudyMember[]
  assignments Assignment[]
  createdAt   DateTime      @default(now())

  @@index([ownerId])
}

model StudyMember {
  id        String     @id @default(cuid())
  group     StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId   String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime   @default(now())

  @@unique([groupId, userId])
  @@index([userId])
}

/// Задание: с какой компании студент начинает и с чем сравниваются его обороты за период.
model Assignment {
  id            String       @id @default(cuid())
  group         StudyGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId       String
  title         String
  text          String
  preset        String?      // встроенное задание из пособия, например "beles-oct-2026"
  baseCompanyId String?      // null — копия демо-компании ОсОО «Белес»
  periodFrom    String       // YYYY-MM-DD
  periodTo      String
  key           Json         // эталонные обороты: { "1410": { "d": 280000, "c": 280000 }, … }
  showAnswers   Boolean      @default(false)
  dueAt         DateTime?
  submissions   Submission[]
  createdAt     DateTime     @default(now())

  @@index([groupId])
}

/// Работа студента: его копия компании и результат последней проверки.
model Submission {
  id           String     @id @default(cuid())
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  assignmentId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  company      Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId    String
  score        Float?
  result       Json?
  checks       Int        @default(0)
  checkedAt    DateTime?
  createdAt    DateTime   @default(now())

  @@unique([assignmentId, userId])
  @@index([companyId])
}

/// История журнала проводок: кто, когда и что добавил, изменил или удалил.
/// Пишется автоматически при любой записи в журнал (lib/ledger/guard.ts); снимок проводки — до и после.
/// Также сюда попадают установка и снятие запрета изменений периода.
model EntryEvent {
  id        String   @id @default(cuid())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String
  /// без внешнего ключа: история удалённой проводки остаётся
  entryId   String?
  action    String   // create | update | delete | import | lock | unlock | attach | detach
  source    String?
  entryDate DateTime?
  userId    String?
  userName  String?
  before    Json?
  after     Json?
  note      String?
  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([entryId])
}

/// Скан или фото первичного документа, прикреплённое к проводке. Хранится в самой базе (bytea):
/// изображения сжимаются в браузере до ~1600 px, файл — не больше 4 МБ. Удаление проводки
/// файл не удаляет — он остаётся для истории.
model Attachment {
  id        String   @id @default(cuid())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String
  entryId   String?
  name      String
  mime      String
  size      Int
  data      Bytes
  userName  String?
  createdAt DateTime @default(now())

  @@index([companyId, entryId])
}
